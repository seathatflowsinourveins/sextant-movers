{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "cleanupPeriodDays": 365,
  "idleCompaction": true,
  "env": {
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "8",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "deny": [
      "Bash(wsl.exe *)",
      "Bash(*/wsl.exe)",
      "Bash(*/wsl.exe *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(*/git push * main)",
      "Bash(*/git push * main *)",
      "Bash(*/git push *:main)",
      "Bash(*/git push *:main *)",
      "Bash(*/git push *+main)",
      "Bash(*/git push *+main *)",
      "Bash(*/git push *refs/heads/main)",
      "Bash(*/git push *refs/heads/main *)",
      "Bash(git push *--all*)",
      "Bash(git push *--branches*)",
      "Bash(git push *--mirror*)",
      "Bash(*/git push *--all*)",
      "Bash(*/git push *--branches*)",
      "Bash(*/git push *--mirror*)",
      "Bash(git worktree add *)",
      "Bash(*/git worktree add)",
      "Bash(*/git worktree add *)",
      "Bash(printenv *)",
      "Bash(*/printenv)",
      "Bash(*/printenv *)",
      "Bash(env *)",
      "Bash(*/env)",
      "Bash(*/env *)",
      "Bash(export *-p)",
      "Bash(export *-p *)",
      "Bash(sudo *wsl.exe*)",
      "Bash(sudo *env*)",
      "Bash(sudo *git push*)",
      "Bash(sudo *git worktree add*)",
      "Bash(*/sudo *wsl.exe*)",
      "Bash(*/sudo *env*)",
      "Bash(*/sudo *git push*)",
      "Bash(*/sudo *git worktree add*)",
      "Bash(doas *wsl.exe*)",
      "Bash(doas *env*)",
      "Bash(doas *git push*)",
      "Bash(doas *git worktree add*)",
      "Bash(*/doas *wsl.exe*)",
      "Bash(*/doas *env*)",
      "Bash(*/doas *git push*)",
      "Bash(*/doas *git worktree add*)",
      "Bash(exec *wsl.exe*)",
      "Bash(exec *env*)",
      "Bash(exec *git push*)",
      "Bash(exec *git worktree add*)",
      "Bash(*/exec *wsl.exe*)",
      "Bash(*/exec *env*)",
      "Bash(*/exec *git push*)",
      "Bash(*/exec *git worktree add*)",
      "Bash(env *wsl.exe*)",
      "Bash(env *env*)",
      "Bash(env *git push*)",
      "Bash(env *git worktree add*)",
      "Bash(*/env *wsl.exe*)",
      "Bash(*/env *env*)",
      "Bash(*/env *git push*)",
      "Bash(*/env *git worktree add*)",
      "Bash(nice *wsl.exe*)",
      "Bash(nice *env*)",
      "Bash(nice *git push*)",
      "Bash(nice *git worktree add*)",
      "Bash(*/nice *wsl.exe*)",
      "Bash(*/nice *env*)",
      "Bash(*/nice *git push*)",
      "Bash(*/nice *git worktree add*)",
      "Bash(timeout *wsl.exe*)",
      "Bash(timeout *env*)",
      "Bash(timeout *git push*)",
      "Bash(timeout *git worktree add*)",
      "Bash(*/timeout *wsl.exe*)",
      "Bash(*/timeout *env*)",
      "Bash(*/timeout *git push*)",
      "Bash(*/timeout *git worktree add*)",
      "Bash(stdbuf *wsl.exe*)",
      "Bash(stdbuf *env*)",
      "Bash(stdbuf *git push*)",
      "Bash(stdbuf *git worktree add*)",
      "Bash(*/stdbuf *wsl.exe*)",
      "Bash(*/stdbuf *env*)",
      "Bash(*/stdbuf *git push*)",
      "Bash(*/stdbuf *git worktree add*)",
      "Bash(xargs *wsl.exe*)",
      "Bash(xargs *env*)",
      "Bash(xargs *git push*)",
      "Bash(xargs *git worktree add*)",
      "Bash(*/xargs *wsl.exe*)",
      "Bash(*/xargs *env*)",
      "Bash(*/xargs *git push*)",
      "Bash(*/xargs *git worktree add*)",
      "Bash(nohup *wsl.exe*)",
      "Bash(nohup *env*)",
      "Bash(nohup *git push*)",
      "Bash(nohup *git worktree add*)",
      "Bash(*/nohup *wsl.exe*)",
      "Bash(*/nohup *env*)",
      "Bash(*/nohup *git push*)",
      "Bash(*/nohup *git worktree add*)",
      "Bash(time *wsl.exe*)",
      "Bash(time *env*)",
      "Bash(time *git push*)",
      "Bash(time *git worktree add*)",
      "Bash(*/time *wsl.exe*)",
      "Bash(*/time *env*)",
      "Bash(*/time *git push*)",
      "Bash(*/time *git worktree add*)",
      "Bash(builtin *wsl.exe*)",
      "Bash(builtin *env*)",
      "Bash(builtin *git push*)",
      "Bash(builtin *git worktree add*)",
      "Bash(*/builtin *wsl.exe*)",
      "Bash(*/builtin *env*)",
      "Bash(*/builtin *git push*)",
      "Bash(*/builtin *git worktree add*)",
      "Bash(noglob *wsl.exe*)",
      "Bash(noglob *env*)",
      "Bash(noglob *git push*)",
      "Bash(noglob *git worktree add*)",
      "Bash(*/noglob *wsl.exe*)",
      "Bash(*/noglob *env*)",
      "Bash(*/noglob *git push*)",
      "Bash(*/noglob *git worktree add*)",
      "Bash(setsid *wsl.exe*)",
      "Bash(setsid *env*)",
      "Bash(setsid *git push*)",
      "Bash(setsid *git worktree add*)",
      "Bash(*/setsid *wsl.exe*)",
      "Bash(*/setsid *env*)",
      "Bash(*/setsid *git push*)",
      "Bash(*/setsid *git worktree add*)",
      "Bash(git -* push * main)",
      "Bash(git --* push * main)",
      "Bash(git -* push *:main)",
      "Bash(git --* push *:main)",
      "Bash(git -* push *+main)",
      "Bash(git --* push *+main)",
      "Bash(git -* push *refs/heads/main)",
      "Bash(git --* push *refs/heads/main)",
      "Bash(git -* push *--all*)",
      "Bash(git --* push *--all*)",
      "Bash(git -* push *--branches*)",
      "Bash(git --* push *--branches*)",
      "Bash(git -* push *--mirror*)",
      "Bash(git --* push *--mirror*)",
      "Bash(git -* worktree add *)",
      "Bash(git --* worktree add *)",
      "Bash(*/git -* push * main)",
      "Bash(*/git --* push * main)",
      "Bash(*/git -* push *:main)",
      "Bash(*/git --* push *:main)",
      "Bash(*/git -* push *+main)",
      "Bash(*/git --* push *+main)",
      "Bash(*/git -* push *refs/heads/main)",
      "Bash(*/git --* push *refs/heads/main)",
      "Bash(*/git -* push *--all*)",
      "Bash(*/git --* push *--all*)",
      "Bash(*/git -* push *--branches*)",
      "Bash(*/git --* push *--branches*)",
      "Bash(*/git -* push *--mirror*)",
      "Bash(*/git --* push *--mirror*)",
      "Bash(*/git -* worktree add *)",
      "Bash(*/git --* worktree add *)",
      "Bash(*sh -*c* *wsl.exe*)",
      "Bash(*sh -*c* *printenv*)",
      "Bash(*sh -*c* *env*)",
      "Bash(*sh -*c* *git push*)",
      "Bash(*sh -*c* *git worktree add*)",
      "Bash(*cmd.exe *wsl*)",
      "Bash(*powershell* *wsl*)",
      "Bash(*pwsh *wsl*)",
      "Bash(*cmd.exe *Env*)",
      "Bash(*powershell* *Env*)",
      "Bash(*pwsh *Env*)",
      "Bash(*cmd.exe *env*)",
      "Bash(*powershell* *env*)",
      "Bash(*pwsh *env*)",
      "Bash(*cmd.exe *set*)",
      "Bash(*powershell* *set*)",
      "Bash(*pwsh *set*)",
      "Edit(//mnt/wsl/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/scripts/compact_context.py\" session-start || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/scripts/compact_context.py\" pre-compact || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "compound-engineering@compound-engineering-plugin": true,
    "claude-hud@claude-hud": true,
    "pyright-lsp@movers-lsp": true,
    "typescript-lsp@movers-lsp": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers",
        "ref": "v7.0.2"
      },
      "autoUpdate": false
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin",
        "ref": "compound-engineering-v3.36.0"
      },
      "autoUpdate": false
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud",
        "ref": "v0.15.0"
      },
      "autoUpdate": false
    },
    "movers-lsp": {
      "source": {
        "source": "directory",
        "path": "./.claude/lsp"
      },
      "autoUpdate": false
    }
  }
}
